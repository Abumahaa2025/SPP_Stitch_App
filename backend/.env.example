# =============================================================================
# SPP Backend secrets — copy to `.env` and fill real values locally.
# NEVER commit `.env` (gitignored). NEVER hardcode keys in Python source.
# =============================================================================

# Debug: when true, API 500s may include a redacted debug hint (local only)
SPP_DEBUG=false

# Mongo (demo / fallback)
MONGO_URL=mongodb://localhost:27017
DB_NAME=spp

# Demo seed — off by default (production: empty portfolio until owner adds data)
SPP_DEMO_MODE=false

# AI keys (leave empty to run local/deterministic modes)
EMERGENT_LLM_KEY=
GEMINI_API_KEY=
AI_API_KEY=
AI_ENABLED=false

# Optional later: Expo client enrich for Smart Employee (no key = local-only)
# EXPO_PUBLIC_EMPLOYEE_ENRICH_URL=
# EXPO_PUBLIC_EMPLOYEE_LLM_KEY=

# Google Apps Script — live data (read-only, lite actions)
<<<<
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbyfGVaod79j2J7QytcDcTiyx7oh5ioQODLBkARZ5-vVjTg7EiW2g1SzNZeKjxp3Pbv1rQ/exec

# Use your own deploy URL; do not paste production secrets into git.
GOOGLE_APPS_SCRIPT_URL=

SPP_API_KEY=

# WhatsApp via Green API (optional — without these, app uses wa.me deep links)
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
GREEN_API_API_URL=https://api.green-api.com
GREEN_API_TIMEOUT_SECONDS=30

# Home Assistant sensors (optional — /api/sensors falls back to mongo/seed)
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_ENTITY_PREFIX=sensor.
HOME_ASSISTANT_TIMEOUT_SECONDS=20

# Optional LLM (OpenAI-compatible, including Gemini OpenAI endpoint)
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1

# Global default when per-domain flag omitted
SPP_DATA_SOURCE=hybrid

# Per-domain source: mongo | gas | hybrid (gas first, mongo fallback)
SPP_PROPERTIES_SOURCE=hybrid
SPP_TENANTS_SOURCE=hybrid
SPP_CONTRACTS_SOURCE=hybrid
SPP_DECISIONS_SOURCE=hybrid
SPP_REPORTS_SOURCE=hybrid
SPP_ALERTS_SOURCE=hybrid

# Ejar (منصة إيجار) webhooks
EJAR_ENABLED=false
EJAR_WEBHOOK_SECRET=

# Utilities (electricity / water) webhooks
UTILITIES_ENABLED=false
ELECTRICITY_WEBHOOK_SECRET=
WATER_WEBHOOK_SECRET=
UTILITIES_WEBHOOK_SECRET=

# Automated messaging & intelligence platform webhooks
PLATFORM_WEBHOOK_SECRET=
MESSAGING_WEBHOOK_SECRET=
INTELLIGENCE_WEBHOOK_SECRET=
